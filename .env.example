# Backend environment variables.
#
# For local development:  cp .env.example .env
# The uncommented values below are a working local setup — the app will start
# with no further edits. Everything commented out is optional.

# --- Required ---------------------------------------------------------------

# 1 enables Django debug mode. Any other value disables it.
DEBUG=1

# Local development only. Generate a real one for production with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-only-insecure-key-replace-me-in-production

# SQLite keeps local setup dependency-free. Production uses PostgreSQL, e.g.
#   DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# --- System companion (AI) --------------------------------------------------
# Optional. Without a key the System tab returns an error; every other feature
# works normally.

# 'nvidia' (default, free, rate-limited) or 'anthropic' (billed)
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=your-nvidia-key-here          # free key at build.nvidia.com
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct     # optional override
# ANTHROPIC_API_KEY=your-anthropic-key-here    # only if AI_PROVIDER=anthropic

# --- Deployment -------------------------------------------------------------
# Not needed locally.

# ALLOWED_HOSTS=your-app.onrender.com,localhost
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
